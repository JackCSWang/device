# Build the Linux AppImage against an OLD base, never the dev host.
#
# Two problems this exists to solve, both found by building on the Arch host
# first (see docs/manual-test-matrix.md):
#
#  1. An AppImage inherits its build host's glibc as a hard floor. Arch is on
#     glibc 2.44; Ubuntu 24.04 LTS ships 2.39, so a host-built AppImage will
#     not start on a technician's machine at all. 22.04 (glibc 2.35) is old
#     enough to cover every target that matters and still new enough to build
#     Qt 6.8 against.
#  2. The host build bundled Arch's system FFmpeg into the AppImage, which
#     segfaulted the dynamic loader when Qt Multimedia dlopen'd its backend.
#     The official Qt binaries installed below ship their OWN FFmpeg, so that
#     conflict cannot arise here.
ARG UBUNTU_VERSION=22.04
FROM ubuntu:${UBUNTU_VERSION}

ARG QT_VERSION=6.8.3
ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update && apt-get install -y --no-install-recommends \
      build-essential cmake ninja-build git curl ca-certificates file \
      python3 python3-pip python3-venv desktop-file-utils \
      libgl1-mesa-dev libglu1-mesa-dev libegl1-mesa-dev \
      libxkbcommon-dev libxkbcommon-x11-dev \
      libx11-xcb-dev libxcb1-dev libxcb-glx0-dev libxcb-icccm4-dev \
      libxcb-image0-dev libxcb-keysyms1-dev libxcb-randr0-dev \
      libxcb-render-util0-dev libxcb-shape0-dev libxcb-shm0-dev \
      libxcb-sync-dev libxcb-util-dev libxcb-xfixes0-dev \
      libxcb-xinerama0-dev libxcb-xkb-dev libxcb-cursor-dev \
      libfontconfig1-dev libfreetype6-dev libdbus-1-dev \
      libwayland-dev libvulkan-dev libasound2-dev libpulse-dev \
    && rm -rf /var/lib/apt/lists/*

# Qt 6.8 is far newer than anything 22.04 packages, so take the official
# binaries rather than the distro's.
RUN pip3 install --no-cache-dir aqtinstall
# qtwayland is not optional: without it this Qt install has no
# platforms/libqwayland*.so for build-appimage.sh to stage, and that script
# now fails hard rather than producing an AppImage that aborts on startup on
# a Wayland-only session.
RUN aqt install-qt linux desktop ${QT_VERSION} linux_gcc_64 \
      -m qtmultimedia qtshadertools qtimageformats qtwayland \
      -O /opt/Qt

ENV QTDIR=/opt/Qt/${QT_VERSION}/gcc_64
ENV CMAKE_PREFIX_PATH=${QTDIR}
ENV PATH=${QTDIR}/bin:/opt/linuxdeploy:${PATH}

RUN mkdir -p /opt/linuxdeploy && cd /opt/linuxdeploy && \
    curl -fsSL -o linuxdeploy \
      https://github.com/linuxdeploy/linuxdeploy/releases/download/continuous/linuxdeploy-x86_64.AppImage && \
    curl -fsSL -o linuxdeploy-plugin-qt \
      https://github.com/linuxdeploy/linuxdeploy-plugin-qt/releases/download/continuous/linuxdeploy-plugin-qt-x86_64.AppImage && \
    chmod +x linuxdeploy linuxdeploy-plugin-qt

# A container has no /dev/fuse, so AppImages must self-extract to run at all.
ENV APPIMAGE_EXTRACT_AND_RUN=1
WORKDIR /src
